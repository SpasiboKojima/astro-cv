---
import { Image } from 'astro:assets';
import ArrowMoveLeftIcon from '~/assets/icons/arrowMoveLeft.svg';
import BuildingIcon from '~/assets/icons/building.svg';
import DownloadIcon from '~/assets/icons/download.svg';
import EmailIcon from '~/assets/icons/email.svg';
import GithubIcon from '~/assets/icons/github.svg';
import LinkedinIcon from '~/assets/icons/linkedin.svg';
import LocationIcon from '~/assets/icons/location.svg';
import PhotoImg from '~/assets/images/photo.jpg';
import TeamUpImg from '~/assets/images/projects/teamUp/favicon-32x32.png';
import { KeyHints } from '~/components/KeyHints';
import ListItem from '~/components/ListItem.astro';
import { mainDescription, jobs, location, personalWork, position, projects, skillsPrimary } from '~/data';
import Layout from '../layouts/Layout.astro';

const email = 'andrew.katsewich@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/andrew-katsewich/';
const githubUrl = 'https://github.com/SpasiboKojima';
---

<Layout>
	<main class='font-geist text-base-content mx-auto w-full max-w-2xl bg-transparent px-6 pt-20 pb-24 antialiased sm:pt-28 sm:pb-32'>
		<header>
			<div class='flex items-center gap-5 sm:gap-6'>
				<Image
					src={PhotoImg}
					alt='Andrew Katsewich'
					quality={100}
					class='outline-base-100/10 size-18 shrink-0 rounded-full object-cover outline-1 -outline-offset-1 sm:size-24'
					width={192}
					height={192}
					loading='eager'
				/>
				<div>
					<h1 class='text-2xl font-semibold tracking-[-0.3px] text-balance sm:text-3xl'>Andrew Katsewich</h1>
					<p class='text-base-content/80 text-base sm:text-lg'>{position}</p>
					<!-- <p class='text-base-content/80 text-base sm:text-lg'>{position} • {location}</p> -->

					<div class='text-base-content/60 mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm'>
						<span class='flex items-center gap-1.5'>
							<LocationIcon class='size-4 shrink-0' />
							{location}
						</span>
						<span class='flex items-center gap-1.5'>
							<BuildingIcon class='size-4 shrink-0' />
							{jobs[0].employerName}
						</span>
					</div>
				</div>
			</div>

			<p class='text-base-content/80 mt-6 text-base/relaxed text-pretty whitespace-pre-line sm:text-base sm:leading-7'>
				{mainDescription.trim()}{' '}
				<a
					href='https://team-up.social'
					target='_blank'
					rel='noopener noreferrer'
					class='link link-hover hover:text-base-content inline-flex items-center gap-1.5 align-bottom font-medium transition-colors'
				>
					<Image
						src={TeamUpImg}
						alt='Team Up logo'
						quality={100}
						class='inline size-5 shrink-0 object-cover'
						width={20}
						height={20}
						loading='eager'
					/>
					Team Up
				</a>
				.
			</p>

			<ul class='mt-4 flex flex-wrap gap-x-3 gap-y-2' aria-label='Core stack'>
				{skillsPrimary.map((item) => <li class='badge badge-default badge-lg'>{item}</li>)}
			</ul>

			<div class='mt-10 flex flex-wrap items-center gap-3'>
				<a class='btn btn-primary w-full px-5 sm:w-auto' href='./Andrew_Katsewich_Resume.pdf' target='_blank' referrerpolicy='no-referrer'>
					<DownloadIcon class='size-4.5' />
					Download Resume
				</a>
				<div class='mx-auto flex items-center gap-3 sm:mx-0'>
					<a class='btn btn-ghost btn-circle' aria-label='Email' href={`mailto:${email}`}>
						<EmailIcon class='size-4.5' />
					</a>
					<a class='btn btn-ghost btn-circle' aria-label='LinkedIn profile' href={linkedinUrl} target='_blank' rel='noopener noreferrer'>
						<LinkedinIcon class='size-5' />
					</a>
					<a class='btn btn-ghost btn-circle' aria-label='GitHub profile' href={githubUrl} target='_blank' rel='noopener noreferrer'>
						<GithubIcon class='size-5' />
					</a>
				</div>
			</div>
		</header>

		<div class='mt-20 flex flex-col gap-20 sm:mt-24 sm:gap-24'>
			<section aria-labelledby='experience'>
				<h2 id='experience' class='text-base-content/60 mb-4 text-xs font-semibold tracking-[0.12em] uppercase'>Experience</h2>
				<div class='flex flex-col'>
					{
						jobs.map((job) => (
							<ListItem title={job.employerName} subtitle={job.title} period={job.period} description={job.shortDescription} />
						))
					}
				</div>
			</section>

			<section aria-labelledby='projects'>
				<div class='mb-4 flex items-center justify-between'>
					<h2 id='projects' class='text-base-content/60 text-xs font-semibold tracking-[0.12em] uppercase'>Featured Projects</h2>
					<a
						href='/projects'
						class='group text-base-content/60 hover:text-base-content -m-4 inline-flex items-center gap-2 p-4 text-sm transition-colors'
						data-astro-prefetch
					>
						View all
						<ArrowMoveLeftIcon class='size-4 rotate-180 transition-transform motion-safe:group-hover:translate-x-1' />
					</a>
				</div>
				<div class='flex flex-col'>
					{
						projects.map(
							(project) =>
								project.slug && (
									<ListItem
										title={project.title}
										subtitle={project.employerName}
										period={project.period}
										description={project.shortDescription}
										href={`/p/${project.slug}`}
									/>
								),
						)
					}
				</div>
			</section>

			<section aria-labelledby='personal-work'>
				<h2 id='personal-work' class='text-base-content/60 mb-4 text-xs font-semibold tracking-[0.12em] uppercase'>Personal Work</h2>
				<div class='flex flex-col'>
					{
						personalWork.map((item) => (
							<ListItem
								title={item.title}
								subtitle={item.type}
								period={String(item.year)}
								description={item.shortDescription}
								href={item.url}
								external
							/>
						))
					}
				</div>
			</section>
		</div>
	</main>

	<KeyHints
		client:load
		hints={[{ key: 'T', description: 'Change Theme' }]}
		isRender={true}
		storageKey='isThemePressed'
		animationDelay='5s'
	/>
</Layout>

<script is:inline>
	const mainElement = document.querySelector('body');
	const cookieName = 'isFirstTime';

	if (!document.cookie.includes(cookieName)) {
		mainElement?.classList.add('reveal');

		document.cookie = `${cookieName}=true; expires=Fri, 31 Dec 9999 23:59:59 GMT`;
	}
</script>
