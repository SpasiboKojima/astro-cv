---

---

<button
	aria-label='Toggle theme'
	id='themeToggle'
	class='btn btn-ghost btn-circle absolute top-4 right-4 z-20 size-11 lg:fixed lg:top-6 lg:right-6'
>
	<svg viewBox='0 0 24 24' class='theme-icon size-5 duration-300 ease-out motion-safe:transition-transform' aria-hidden='true'>
		<circle cx='12' cy='12' r='9' fill='none' stroke='currentColor' stroke-width='1.5'></circle>
		<path d='M12 3a9 9 0 0 1 0 18z' fill='currentColor'></path>
	</svg>
</button>

<style>
	:global([data-theme='dark']) .theme-icon {
		rotate: 180deg;
	}
</style>

<script is:inline>
	const theme = (() => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme') ?? 'light';
		}
		if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
			return 'dark';
		}
		return 'light';
	})();

	const isDark = theme === 'dark';
	document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

	window.localStorage.setItem('theme', theme);

	document.addEventListener('astro:after-swap', function () {
		const isDark = localStorage.getItem('theme') === 'dark';
		document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');

		document.getElementById('themeToggle')?.addEventListener('click', handleToggleClick);
	});
</script>
<script>
	import { WebHaptics, defaultPatterns } from 'web-haptics';
	const haptics = new WebHaptics();

	const handleToggleClick = () => {
		const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
		localStorage.setItem('theme', !isDark ? 'dark' : 'light');
		haptics.trigger(defaultPatterns.soft);

		document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
	};

	document.getElementById('themeToggle')?.addEventListener('click', handleToggleClick);
</script>
