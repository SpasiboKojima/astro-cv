---
interface Props {
	title: string;
	employerName: string;
	period: string;
	description: string;
}

const { employerName, title, period, description } = Astro.props;
---

<div class="w-full text-sm tracking-tight">
	<div class="flex items-center justify-between">
		<h3 class="text-base font-medium">{employerName}</h3>
		<div>{period}</div>
	</div>
	<div>{title}</div>
	<p class="mt-2 pl-4 whitespace-pre-line">{description}</p>
</div>
