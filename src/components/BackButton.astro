---
import ArrowMoveLeftIcon from '~/assets/icons/chevron-left.svg';
---

<a
	href='/'
	class='group btn btn-circle fixed top-4 left-4 z-20 flex size-11 items-center border-none bg-white/75 backdrop-blur-md lg:hidden dark:bg-zinc-900/75'
	style={{
		boxShadow: '0px -2px 2px rgba(0, 0, 0, 0.05), 0px 2px 4px rgba(0, 0, 0, 0.05), inset 0px 1px 0px 0px rgba(255, 255, 255, 0.15)',
	}}
	aria-label='Back to Home page'
>
	<ArrowMoveLeftIcon class='stroke-base-content -ml-0.5 size-8 transition-transform motion-safe:group-hover:-translate-x-1' />
</a>
