---
import ArrowUpRight from '~/assets/icons/arrowUpRight.svg';

interface Props {
	title: string;
	period?: string;
	subtitle?: string;
	description?: string;
	href?: string;
	external?: boolean;
}

const { title, period, subtitle, description, href, external = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
	class:list={[
		'group rounded-box -mx-4 grid gap-x-6 gap-y-1 px-4 py-4 sm:grid-cols-[10rem_1fr]',
		href && 'hover:bg-base-content/4 focus-visible:bg-base-content/4 transition-colors duration-200',
	]}
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	data-astro-prefetch={href && !external ? '' : undefined}
>
	<div class="text-base-content/60 text-sm whitespace-nowrap tabular-nums sm:pt-0.5">{period?.replace(' - ', ' – ')}</div>
	<div>
		<h3 class="text-base-content font-medium">
			{title}
			{href && (
				<ArrowUpRight class="text-base-content/50 group-hover:text-base-content ml-0.5 inline size-4 align-text-bottom transition-[translate,color] duration-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" />
			)}
		</h3>
		{subtitle && <p class="text-base-content/60 text-sm">{subtitle}</p>}
		{description && <p class="text-base-content/75 mt-2 text-sm/relaxed text-pretty">{description}</p>}
	</div>
</Tag>
